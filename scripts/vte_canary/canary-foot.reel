REEL main
  mode = tui
  terminal = ["foot", "--override=tweak.grapheme-shaping=yes", "--override=tweak.grapheme-width-method=double-width", "--override=font=monospace:size=14, Twitter Color Emoji:size=14, Twemoji:size=14, Noto Color Emoji:size=14, OpenMoji:size=14, JoyPixels:size=14"]
  terminal_startup_delay = 1s
  # Clear VTE_VERSION/TILIX_ID/TERMINAL so a developer's own VTE-based host
  # terminal (e.g. Tilix) can't leak through os.Environ() into this foot
  # capture and cause vte_canary's isVteTerminal() to falsely self-detect as
  # VTE, silently enabling unwanted weather-symbol auto-compensation.
  env = ["DBUS_SESSION_BUS_ADDRESS=", "DISPLAY=:99", "VTE_VERSION=", "TILIX_ID=", "TERMINAL="]
  build = ["go", "build", "-o", "/tmp/vte_canary_bin", "scripts/vte_canary/main.go"]

  $ "/tmp/vte_canary_bin -s"
  I mode=app path="scripts/vte_canary/shots/canary-foot.png" desc=canary-foot crop_colors=["ff0000","00ff00","0000ff","ffff00"] crop_tolerance=0 crop_pad="4,4,4,4"
  X
