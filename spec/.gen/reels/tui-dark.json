{
  "$schema": "../../../wayreel/reel.schema.json",
  "mode": "tui",
  "build": [
    "zig",
    "build",
    "-Doptimize=ReleaseSmall"
  ],
  "binary": "zig-out/bin/emojig",
  "bitrate": "2M",
  "fps": 30,
  "scene_width": 850,
  "scene_height": 480,
  "app_width": 600,
  "app_height": 400,
  "theme": "dark",
  "font_size": 12,
  "output": "website/emojig-tui-dark.webm",
  "title": "emojig demo",
  "prompt": [
    {
      "text": "➜",
      "color": "green"
    },
    {
      "text": "  "
    },
    {
      "text": "~",
      "color": "cyan"
    },
    {
      "text": " "
    }
  ],
  "shell_init": [
    "source $(pwd)/src/shell/emojig.sh"
  ],
  "env": [
    "EMOJIG_THEME=dark"
  ],
  "pause": "1s",
  "script": [
    {
      "type": "echo Hello TUI ",
      "desc": "echo start",
      "pause": 0
    },
    {
      "type": "\u003cC-o\u003e",
      "desc": "open emojig",
      "show_keys": true
    },
    {
      "type": "car",
      "desc": "search for 'car'",
      "speed": 0.4
    },
    {
      "type": "\u003cbs\u003e\u003cbs\u003e\u003cbs\u003e",
      "desc": "delete search",
      "speed": 0.4,
      "pause": "300ms"
    },
    {
      "type": "cat",
      "desc": "search for cat",
      "speed": 0.4
    },
    {
      "type": "\u003ccr\u003e",
      "desc": "select cat",
      "show_keys": true
    },
    {
      "type": "\u003ccr\u003e",
      "desc": "confirm echo"
    }
  ]
}
